{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "surface-shadcn",
  "homepage": "https://rusl.com",
  "items": [
    {
      "name": "surface",
      "type": "registry:item",
      "title": "Surface shadcn kit",
      "description": "Schema-driven input and display using your application's local shadcn Base UI components.",
