{
  "name": "@rusl-labs/surface-shadcn",
  "version": "0.1.0",
  "description": "Runtime helpers for the Surface shadcn/ui kit, which renders JSON Schema forms and displays with your shadcn components.",
  "keywords": [
    "surface",
    "shadcn",
    "shadcn-ui",
    "json-schema",
    "react",
    "forms",
    "rusl"
  ],
  "homepage": "https://surface-shadcn.rusl.com",
  "bugs": {
    "url": "https://github.com/rusl-labs/surface-shadcn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusl-labs/surface-shadcn.git"
  },
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "example"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas/rusl/surface.shadcn.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schemas/rusl/surface.shadcn.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "build:registry": "shadcn build --output public/r",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "check": "bun run check:runtime && bun run typecheck && bun run test && bun run build && bun run build:registry && bun run build:example",
    "check:runtime": "bun scripts/assert-surface-runtime.ts",
    "prepack": "bun run build",
    "dev": "vite --config example/vite.config.ts",
    "site:install": "bun install --cwd site",
    "site:dev": "bun --cwd site dev",
    "site:build": "bun --cwd site build",
    "test:next": "bun scripts/test-next.ts",
    "test:next:clean": "bun scripts/test-next.ts clean",
    "build:example": "vite build --config example/vite.config.ts"
  },
  "peerDependencies": {
    "@rusl-labs/surface": "^0.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@codemirror/view": "^6.43.11",
    "@happy-dom/global-registrator": "^20.0.0",
    "@rusl-labs/surface": "0.1.1",
    "@rusl-labs/surface-ajv": "0.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.12"
  }
}
