{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@rusl-labs/surface-shadcn": ["./src/index.ts"],
      "@/*": ["./example/src/*"]
    }
  },
  "include": ["src", "registry", "example/src", "example/vite.config.ts"]
}
